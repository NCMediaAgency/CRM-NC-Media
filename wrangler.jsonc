// Configurazione per Cloudflare Workers: pubblica il sito costruito in dist/.
// Il nome deve coincidere con quello del progetto su Cloudflare.
{
  "name": "crm-nc-media",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
