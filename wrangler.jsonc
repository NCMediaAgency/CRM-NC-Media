// Configurazione per Cloudflare Workers: pubblica il sito costruito in dist/.
// Il nome deve coincidere con quello del progetto su Cloudflare.
{
  "name": "crm-nc-media",
  "compatibility_date": "2026-10-01",
  // Indirizzo *.workers.dev e link di anteprima per i branch diversi da main
  "workers_dev": true,
  "preview_urls": true,
  // Richiesto da `wrangler preview` (anteprime dei branch): vuoto, eredita tutto il resto
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
